# Server
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (current key naming — see docs/DECISIONS.md ADR-003)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Postgres — Supabase transaction pooler connection string
DATABASE_URL=

# Test project (separate Supabase project — never point this at production)
TEST_DATABASE_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_SECRET_KEY=

# Seed / demo
DEMO_PASSWORD=

# Rate limiting
LOGIN_RATE_LIMIT_PER_15MIN=10

# Client (no secrets — must be safe to ship in the bundle)
VITE_SITE_URL=http://localhost:5173
